# URL pública do app (usada no checkout, sitemap e metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (opcional) ---
# Sem estas variáveis o app roda em modo demonstração: o checkout libera
# o acesso localmente para você avaliar a experiência.

# Chave secreta da sua conta Stripe (sk_test_... em desenvolvimento)
STRIPE_SECRET_KEY=sk_test_51UDB2WAlnCYLFjJLyIoiI4jxZOUSq0eBeherRCDHce3XzSoIzhk7K6ivgzCBmmpntqrRzO5iJWDCP04xHbdPg3ik005ihVKHVy

# IDs dos preços recorrentes criados no painel do Stripe (price_...)
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_TRIMESTRAL=
STRIPE_PRICE_ANUAL=

# Segredo do endpoint de webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Alternativa sem backend: Payment Links do Stripe ---
