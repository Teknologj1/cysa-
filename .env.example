# URL pública do app (usada no checkout, sitemap e metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (opcional) ---
# Sem estas variáveis o app roda em modo demonstração: o checkout libera
# o acesso localmente para você avaliar a experiência.
#
# ATENÇÃO: este arquivo é versionado no git e serve apenas de modelo.
# Mantenha todos os valores VAZIOS. Chaves reais vão só no .env.local
# (ignorado pelo git) ou nas variáveis de ambiente da Vercel.

# Chave secreta da sua conta Stripe (sk_test_... em desenvolvimento)
STRIPE_SECRET_KEY=

# IDs dos preços recorrentes criados no painel do Stripe (price_...)
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_TRIMESTRAL=
STRIPE_PRICE_ANUAL=

# Segredo do endpoint de webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Alternativa sem backend: Payment Links do Stripe ---
# Usados apenas quando STRIPE_SECRET_KEY/PRICE não estiverem definidos.
NEXT_PUBLIC_STRIPE_LINK_MENSAL=
NEXT_PUBLIC_STRIPE_LINK_TRIMESTRAL=
NEXT_PUBLIC_STRIPE_LINK_ANUAL=

# --- Contas e acesso (Fase B) ---
# Sem estas variáveis o app continua funcionando, com a assinatura registrada
# apenas no aparelho. Com elas, o acesso passa a valer em qualquer dispositivo.

# Segredo que assina a sessão e o link de acesso. SEGREDO.
# Gere com: openssl rand -base64 32
AUTH_SECRET=

# --- Envio do link de acesso (Resend) ---
# Necessário apenas para quem volta em outro aparelho: quem acabou de comprar
# já entra pelo retorno do pagamento.

# Chave da API do Resend. SEGREDO.
RESEND_SECRET_KEY=

# Remetente verificado no Resend, no formato "Nome <endereco@dominio>"
EMAIL_REMETENTE=

# --- Sincronização do progresso (Upstash Redis) ---
# Sem estas variáveis o progresso continua funcionando, só não acompanha o
# aluno entre aparelhos.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
