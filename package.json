{
  "name": "cysa-prep-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "stripe:setup": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stripe-setup.mjs",
    "verificar:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verificar-deploy.mjs",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON 'src/**/*.test.ts'",
    "gerar:catalogo": "tsx scripts/gerar-catalogo.mjs",
    "gerar:link": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gerar-link.mjs",
    "prebuild": "npm run verificar:conteudo && npm run gerar:catalogo",
    "verificar:bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verificar-bundle.mjs",
    "postbuild": "npm run verificar:bundle",
    "verificar:conteudo": "tsx scripts/verificar-conteudo.mts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "next": "^15.5.25",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
